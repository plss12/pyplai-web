---
import { LEVELS } from "@/engine/levels";
import { STRINGS, describeMove, levelName, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = STRINGS[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const otherPath = locale === "es" ? `${base}en/` : base;
const boards = [...Array(9).keys()];
---

<div class="mx-auto max-w-6xl px-4 py-6 lg:px-8 lg:py-10" data-game data-locale={locale}>
  <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h1 class="text-xl font-bold">{t.title}</h1>
    <nav class="flex gap-4 text-muted">
      <a class="hover:text-ink" href="https://github.com/plss12/pyplai-web">{t.source}</a>
      <a class="hover:text-ink" href={otherPath} hreflang={locale === "es" ? "en" : "es"}>{t.otherLanguage}</a>
    </nav>
  </header>

  <main class="mt-6 grid gap-8 lg:mt-10 lg:grid-cols-[auto_1fr] lg:gap-12">
    <section aria-label={t.board}>
      <div class="board" data-board role="group" aria-label={t.board}>
        {
          boards.map((board) => (
            <div class="small-board" data-small-board={board}>
              {boards.map((cell) => {
                const move = board * 9 + cell;
                const label = t.cell(describeMove(locale, move), t.empty);
                return (
                  <button type="button" class="cell" data-move={move} aria-label={label} tabindex={move === 40 ? 0 : -1}>
                    <span class="heat-label" data-heat-label hidden />
                  </button>
                );
              })}
              <span class="closed-mark" data-closed-mark hidden />
            </div>
          ))
        }
      </div>
    </section>

    <section class="flex max-w-md flex-col gap-6">
      <div>
        <p class="text-status" data-status>{t.loading}</p>
        <p class="mt-3 min-h-[3lh] text-muted" data-detail role="status">{t.intro}</p>
        <button type="button" class="btn btn-secondary mt-2" data-reload hidden>{t.reload}</button>
      </div>

      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn btn-secondary" data-hint disabled>{t.hint}</button>
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 px-1">
          <input type="checkbox" class="size-5 accent-current" data-show-thinking />
          {t.showThinking}
        </label>
      </div>

      <fieldset>
        <legend class="mb-2 font-semibold">{t.level}</legend>
        <div class="choice">
          {
            LEVELS.map((level) => (
              <label>
                <input type="radio" name="level" value={level} checked={level === "medium"} />
                <span>{levelName(locale, level)}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-2 font-semibold">{t.side}</legend>
        <div class="choice">
          <label><input type="radio" name="side" value="1" checked /><span>{t.sideX}</span></label>
          <label><input type="radio" name="side" value="2" /><span>{t.sideO}</span></label>
        </div>
      </fieldset>

      <div>
        <button type="button" class="btn btn-primary" data-new-game>{t.newGame}</button>
      </div>

      <section data-thinking-panel hidden>
        <h2 class="font-semibold">{t.thinkingTitle}</h2>
        <p class="mt-1 text-muted" data-thinking-summary>{t.thinkingEmpty}</p>
        <table class="mt-3 w-full text-left tabular-nums" data-thinking-table hidden>
          <thead class="text-muted">
            <tr>
              <th scope="col" class="py-1 font-normal">{t.move}</th>
              <th scope="col" class="py-1 pl-4 text-right font-normal">{t.winRate}</th>
              <th scope="col" class="py-1 pl-4 text-right font-normal">{t.visits}</th>
            </tr>
          </thead>
          <tbody data-thinking-rows></tbody>
        </table>
      </section>
    </section>
  </main>
</div>

<script>
  import { mountGame } from "@/ui/app";

  for (const root of document.querySelectorAll<HTMLElement>("[data-game]")) mountGame(root);
</script>
