---
import { LEVELS } from "@/engine/levels";
import { STRINGS, describeMove, levelName, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = STRINGS[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const otherPath = locale === "es" ? `${base}en/` : base;
const boards = [...Array(9).keys()];
---

<div class="mx-auto max-w-6xl px-4 py-6 lg:px-8 lg:py-10" data-game data-locale={locale}>
  <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h1 class="text-xl font-bold">{t.title}</h1>
    <nav class="flex gap-4 text-muted">
      <a class="hover:text-ink" href="https://github.com/plss12/pyplai-web">{t.source}</a>
      <a class="hover:text-ink" href={otherPath} hreflang={locale === "es" ? "en" : "es"}>{t.otherLanguage}</a>
    </nav>
  </header>

  <main class="game-layout mt-6 lg:mt-10">
    <section class="[grid-area:board]" aria-label={t.board}>
      <div class="board" data-board role="group" aria-label={t.board}>
        {
          boards.map((board) => (
            <div class="small-board" data-small-board={board}>
              {boards.map((cell) => {
                const move = board * 9 + cell;
                const label = t.cell(describeMove(locale, move), t.empty);
                return (
                  <button type="button" class="cell" data-move={move} aria-label={label} tabindex={move === 40 ? 0 : -1}>
                    <span class="heat-label" data-heat-label hidden />
                  </button>
                );
              })}
              <span class="closed-mark" data-closed-mark hidden />
            </div>
          ))
        }
      </div>
    </section>

    <section class="match [grid-area:match]">
      <p class="current-game" data-current-game hidden>
        <span class="font-semibold text-ink" data-current-level></span>
        <!-- Two lines on screen; a comma keeps them apart for screen readers -->
        <span class="sr-only">, </span>
        <span>{t.side} <strong class="side-mark" data-current-side></strong></span>
      </p>
      <button type="button" class="btn btn-primary new-game" data-new-game>{t.newGame}</button>
    </section>

    <section class="max-w-md [grid-area:status]">
      <p class="text-status" data-status>{t.loading}</p>
      <div class="mt-3 min-h-[3lh] text-muted" role="status">
        <p data-detail>{t.chooseToStart}</p>
        <p class="mt-2 text-ink" data-hint-text hidden>
          <strong>{t.hintLabel}</strong> <span data-hint-body></span>
        </p>
      </div>
      <button type="button" class="btn btn-secondary mt-2" data-reload hidden>{t.reload}</button>
      <button type="button" class="btn btn-secondary mt-4" data-hint-button disabled>{t.hint}</button>
    </section>

    <section class="flex max-w-md flex-col gap-6 [grid-area:settings]">
      <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 self-start">
        <input type="checkbox" class="size-5 accent-current" data-show-thinking />
        {t.showThinking}
      </label>

      <section data-thinking-panel hidden>
        <h2 class="font-semibold">{t.thinkingTitle}</h2>
        <p class="mt-1 text-muted" data-thinking-summary>{t.thinkingEmpty}</p>
        <table class="mt-3 w-full text-left tabular-nums" data-thinking-table hidden>
          <thead class="text-muted">
            <tr>
              <th scope="col" class="py-1 font-normal">{t.move}</th>
              <th scope="col" class="py-1 pl-4 text-right font-normal">{t.winRate}</th>
              <th scope="col" class="py-1 pl-4 text-right font-normal">{t.visits}</th>
            </tr>
          </thead>
          <tbody data-thinking-rows></tbody>
        </table>
      </section>
    </section>
  </main>

  <dialog class="new-game-dialog" data-new-game-dialog aria-labelledby="new-game-title" tabindex="-1">
    <form method="dialog" class="flex flex-col gap-6">
      <h2 id="new-game-title" class="text-2xl font-bold">{t.newGame}</h2>
      <!-- Radio groups instead of fieldset + legend: in this flex column Safari on iOS counted each
           legend's height twice until the next relayout, so the dialog opened too tall -->
      <div role="radiogroup" aria-labelledby="new-game-side">
        <p id="new-game-side" class="mb-2 font-semibold">{t.side}</p>
        <div class="segmented">
          <label><input type="radio" name="side" value="1" checked /><span>{t.sideX}</span></label>
          <label><input type="radio" name="side" value="2" /><span>{t.sideO}</span></label>
        </div>
      </div>
      <div role="radiogroup" aria-labelledby="new-game-level">
        <p id="new-game-level" class="mb-2 font-semibold">{t.level}</p>
        <div class="choice levels">
          {
            LEVELS.map((level) => (
              <label>
                <input type="radio" name="level" value={level} checked={level === "medium"} />
                <span>{levelName(locale, level)}</span>
              </label>
            ))
          }
        </div>
      </div>
      <div class="dialog-actions">
        <button type="submit" value="cancel" class="btn btn-secondary" data-cancel hidden>{t.cancel}</button>
        <button type="submit" value="start" class="btn btn-primary">{t.start}</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { mountGame } from "@/ui/app";

  for (const root of document.querySelectorAll<HTMLElement>("[data-game]")) mountGame(root);
</script>
