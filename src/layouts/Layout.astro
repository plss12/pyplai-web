---
import { Font } from "astro:assets";
import "../styles/global.css";
import { STRINGS, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = STRINGS[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const paths: Record<Locale, string> = { es: base, en: `${base}en/` };
// Social preview: title and a mid-game board, rendered once at 1200 x 630 (public/og*.jpg).
const ogImage: Record<Locale, string> = { es: `${base}og.jpg`, en: `${base}og-en.jpg` };
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={new URL(paths[locale], Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(paths.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.es, Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={new URL(paths[locale], Astro.site)} />
    <meta property="og:image" content={new URL(ogImage[locale], Astro.site)} />
    <meta property="og:image:alt" content={t.title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-instrument" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
